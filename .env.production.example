POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-production-admin-password
POSTGRES_APP_PASSWORD=replace-with-a-long-random-production-app-password
DATABASE_URL=postgresql://pastagansa_app:replace-with-a-long-random-production-app-password@postgres:5432/pastagansa?schema=public
DIRECT_DATABASE_URL=postgresql://pastagansa_admin:replace-with-a-long-random-production-admin-password@postgres:5432/pastagansa?schema=public
JWT_SECRET=replace-with-at-least-32-random-production-characters
JWT_ISSUER=pastagansa
JWT_AUDIENCE=pastagansa-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
THROTTLE_LIMIT=120
OCR_WORKER_ENABLED=true
# Optional. Leave all SMTP_* values empty to disable email delivery safely.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace-with-smtp-user
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_FROM=Facturación <facturacion@example.com>
WEB_PORT=3101
# Leave disabled until the version and issuer have passed the review in docs/17_manual_evidencias_conformidad_sif.md.
PRODUCTION_SIF_OVERLAY=none
# When the reviewed deployment is approved, use verifactu or no-verifactu and
# configure its company, declaration SHA-256, certificate SHA-256, host paths,
# and secret group in the private .env.production file.
