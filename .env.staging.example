POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
POSTGRES_APP_PASSWORD=replace-with-a-long-random-app-password
DATABASE_URL=postgresql://pastagansa_app:replace-with-a-long-random-app-password@postgres:5432/pastagansa?schema=public
DIRECT_DATABASE_URL=postgresql://pastagansa_admin:replace-with-a-long-random-admin-password@postgres:5432/pastagansa?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=pastagansa
JWT_AUDIENCE=pastagansa-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
THROTTLE_LIMIT=1000
OCR_WORKER_ENABLED=true
# Optional SMTP delivery. Leave all SMTP_* values empty to disable email safely.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace-with-smtp-user
# SMTP_PASSWORD=replace-with-smtp-password
# SMTP_FROM=Facturación <facturacion@example.com>

# Experimental AEAT preproduction sender. Keep disabled until a qualified client
# certificate is mounted read-only inside the API container.
AEAT_TEST_ENABLED=false
# AEAT_TEST_PFX_HOST_PATH=/absolute/private/path/aeat-test.p12
# AEAT_TEST_PFX_PATH=/run/secrets/aeat-test.p12
# AEAT_TEST_PFX_PASSPHRASE=replace-in-private-env-only
WEB_PORT=3101
