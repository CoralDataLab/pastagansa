model Quote {
  id                    String                    @id @default(uuid()) @db.Uuid
  organizationId        String                    @map("organization_id") @db.Uuid
  companyId             String                    @map("company_id") @db.Uuid
  contactId             String                    @map("contact_id") @db.Uuid
  sequenceId            String?                   @map("sequence_id") @db.Uuid
  convertedInvoiceId    String?                   @map("converted_invoice_id") @db.Uuid
  customerLegalName     String                    @map("customer_legal_name") @db.VarChar(240)
  customerTaxId         String?                   @map("customer_tax_id") @db.VarChar(40)
  customerEmail         String?                   @map("customer_email") @db.VarChar(320)
  billingAddress        Json?                     @map("billing_address")
  issuerSnapshot        Json                      @default("{}") @map("issuer_snapshot")
  issuerSnapshotVersion Int                       @default(1) @map("issuer_snapshot_version")
  issuerLogoMediaType   String?                   @map("issuer_logo_media_type") @db.VarChar(100)
  issuerLogoSha256      String?                   @map("issuer_logo_sha256") @db.Char(64)
  issuerLogoContent     Bytes?                    @map("issuer_logo_content")
  code                  String                    @default(cuid()) @db.VarChar(40)
  series                String?                   @db.VarChar(30)
  number                BigInt?
  status                QuoteStatus               @default(DRAFT)
  issueDate             DateTime                  @map("issue_date") @db.Date
  validUntil            DateTime?                 @map("valid_until") @db.Date
  currency              String                    @default("EUR") @db.Char(3)
  notes                 String?
  subtotal              Decimal                   @db.Decimal(14, 2)
  discountTotal         Decimal                   @map("discount_total") @db.Decimal(14, 2)
  taxTotal              Decimal                   @map("tax_total") @db.Decimal(14, 2)
  total                 Decimal                   @db.Decimal(14, 2)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company               Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contact               Contact                   @relation(fields: [contactId], references: [id], onDelete: Restrict)
  sequence              DocumentSequence?         @relation(fields: [sequenceId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  convertedInvoice      Invoice?                  @relation(fields: [convertedInvoiceId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  lines                 QuoteLine[]
  emailDeliveries       DocumentDelivery[]
  commercialEvents      CommercialDocumentEvent[]

  @@unique([companyId, code])
  @@unique([companyId, series, number])
  @@unique([id, organizationId, companyId])
  @@unique([convertedInvoiceId, organizationId, companyId])
  @@index([companyId, status, issueDate])
  @@map("quotes")
}

model QuoteLine {
  id             String       @id @default(uuid()) @db.Uuid
  quoteId        String       @map("quote_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  position       Int
  catalogItemId  String?      @map("catalog_item_id") @db.Uuid
  description    String
  quantity       Decimal      @db.Decimal(14, 3)
  unitPrice      Decimal      @map("unit_price") @db.Decimal(14, 2)
  discountPct    Decimal      @default(0) @map("discount_pct") @db.Decimal(5, 2)
  taxRate        Decimal      @default(0) @map("tax_rate") @db.Decimal(5, 2)
  netAmount      Decimal      @map("net_amount") @db.Decimal(14, 2)
  taxAmount      Decimal      @map("tax_amount") @db.Decimal(14, 2)
  totalAmount    Decimal      @map("total_amount") @db.Decimal(14, 2)
  quote          Quote        @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  catalogItem    CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@unique([quoteId, position])
  @@map("quote_lines")
}

model ContactAddress {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  contactId      String       @map("contact_id") @db.Uuid
  type           AddressType  @default(BILLING)
  label          String?      @db.VarChar(120)
  line1          String       @db.VarChar(240)
  line2          String?      @db.VarChar(240)
  postalCode     String       @map("postal_code") @db.VarChar(20)
  city           String       @db.VarChar(120)
  province       String?      @db.VarChar(120)
  country        String       @default("ES") @db.Char(2)
  isDefault      Boolean      @default(false) @map("is_default")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(6)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, contactId, archivedAt])
  @@map("contact_addresses")
}

model User {
  id                        String                      @id @default(uuid()) @db.Uuid
  email                     String                      @unique @db.Citext
  passwordHash              String?                     @map("password_hash")
  status                    UserStatus                  @default(ACTIVE)
  createdAt                 DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships               Membership[]
  auditEvents               AuditEvent[]                @relation("actor_audit_events")
  sessions                  Session[]
  passwordResetTokens       PasswordResetToken[]
  purchaseAttachments       PurchaseInvoiceAttachment[]
  purchaseApprovals         PurchaseInvoiceApproval[]
  requestedPurchaseOcr      PurchaseInvoiceOcrJob[]     @relation("requested_purchase_ocr")
  reviewedPurchaseOcr       PurchaseInvoiceOcrJob[]     @relation("reviewed_purchase_ocr")
  commandExecutions         CommandExecution[]
  commandProposals          CommandProposal[]
  commandProposalRevisions  CommandProposalRevision[]
  assignedCommandProposals  CommandProposalAssignment[] @relation("assigned_command_proposals")
  proposalAssignmentActions CommandProposalAssignment[] @relation("proposal_assignment_actor")
  commandProposalAttempts   CommandProposalAttempt[]
  commandProposalEvents     CommandProposalEvent[]
  commandReviews            CommandReview[]
  createdLearningCandidates CommandLearningCandidate[] @relation("created_learning_candidates")
  reviewedLearningCandidates CommandLearningCandidate[] @relation("reviewed_learning_candidates")
  proposalDocuments         PurchaseProposalDocument[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Session {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  refreshHash  String        @map("refresh_hash")
  tokenVersion Int           @default(0) @map("token_version")
  status       SessionStatus @default(ACTIVE)
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt   DateTime?     @map("last_used_at") @db.Timestamptz(6)
  revokedAt    DateTime?     @map("revoked_at") @db.Timestamptz(6)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("sessions")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(80)
  name        String
  memberships Membership[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  code  String           @unique @db.VarChar(120)
  name  String
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  companyId      String?          @map("company_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, companyId, userId, roleId])
  @@index([userId, organizationId, companyId])
  @@map("memberships")
}

enum CommandProposalStatus {
  PENDING_REVIEW
  EXECUTED
  REJECTED
}

enum CommandReviewDecision {
  EXECUTE
  REJECT
}

enum CommandLearningCandidateStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// Successful command receipts, not an event store or a replayable source of truth.
model CommandExecution {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  commandId      String           @map("command_id") @db.VarChar(128)
  name           String           @db.VarChar(100)
  version        Int
  payloadHash    String           @map("payload_hash") @db.Char(64)
  payload        Json
  evidence       Json
  result         Json
  actorUserId    String           @map("actor_user_id") @db.Uuid
  executedAt     DateTime         @default(now()) @map("executed_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor          User             @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  proposal       CommandProposal?

  @@unique([companyId, commandId])
  @@unique([id, organizationId, companyId])
  @@index([companyId, executedAt], map: "command_executions_company_executed_idx")
  @@map("command_executions")
}

model CommandProposal {
  id             String                      @id @default(uuid()) @db.Uuid
  organizationId String                      @map("organization_id") @db.Uuid
  companyId      String                      @map("company_id") @db.Uuid
  commandId      String                      @map("command_id") @db.VarChar(128)
  name           String                      @db.VarChar(100)
  version        Int
  payloadHash    String                      @map("payload_hash") @db.Char(64)
  payload        Json
  evidence       Json
  // Descriptive provenance supplied by the caller; never an authorization claim.
  provenance     Json
  proposedById   String                      @map("proposed_by_id") @db.Uuid
  status         CommandProposalStatus       @default(PENDING_REVIEW)
  executionId    String?                     @unique @map("execution_id") @db.Uuid
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  proposedBy     User                        @relation(fields: [proposedById], references: [id], onDelete: Restrict)
  execution      CommandExecution?           @relation(fields: [executionId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  review         CommandReview?
  documents      PurchaseProposalDocument[]
  revisions      CommandProposalRevision[]
  assignments    CommandProposalAssignment[]
  attempts       CommandProposalAttempt[]
  events         CommandProposalEvent[]
  learningCandidates CommandLearningCandidate[]

  @@unique([companyId, commandId])
  @@unique([id, organizationId, companyId])
  @@unique([executionId, organizationId, companyId])
  @@index([companyId, status, createdAt], map: "command_proposals_company_status_created_idx")
  @@map("command_proposals")
}

model PurchaseProposalDocument {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  proposalId     String          @map("proposal_id") @db.Uuid
  originalName   String          @map("original_name") @db.VarChar(240)
  mediaType      String          @map("media_type") @db.VarChar(40)
  sizeBytes      Int             @map("size_bytes")
  sha256         String          @db.Char(64)
  content        Bytes
  createdById    String          @map("created_by_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  proposal       CommandProposal @relation(fields: [proposalId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([proposalId, sha256])
  @@index([companyId, proposalId, createdAt])
  @@map("purchase_proposal_documents")
}

model CommandProposalRevision {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  companyId        String          @map("company_id") @db.Uuid
  proposalId       String          @map("proposal_id") @db.Uuid
  revisionNumber   Int             @map("revision_number")
  previousPayload  Json            @map("previous_payload")
  correctedPayload Json            @map("corrected_payload")
  changes          Json
  reason           String          @db.VarChar(1000)
  createdById      String          @map("created_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  proposal         CommandProposal @relation(fields: [proposalId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  createdBy        User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  learningCandidates CommandLearningCandidate[]

  @@unique([proposalId, revisionNumber])
  @@unique([id, organizationId, companyId])
  @@index([companyId, proposalId, createdAt], map: "command_proposal_revisions_company_proposal_created_idx")
  @@map("command_proposal_revisions")
}

model CommandProposalAssignment {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  proposalId     String          @map("proposal_id") @db.Uuid
  assignedToId   String          @map("assigned_to_id") @db.Uuid
  assignedById   String          @map("assigned_by_id") @db.Uuid
  reason         String          @db.VarChar(1000)
  assignedAt     DateTime        @default(now()) @map("assigned_at") @db.Timestamptz(6)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  proposal       CommandProposal @relation(fields: [proposalId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  assignedTo     User            @relation("assigned_command_proposals", fields: [assignedToId], references: [id], onDelete: Restrict)
  assignedBy     User            @relation("proposal_assignment_actor", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([companyId, proposalId, assignedAt], map: "command_proposal_assignments_company_proposal_assigned_idx")
  @@map("command_proposal_assignments")
}

model CommandProposalAttempt {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @map("organization_id") @db.Uuid
  companyId        String          @map("company_id") @db.Uuid
  proposalId       String          @map("proposal_id") @db.Uuid
  attemptedPayload Json            @map("attempted_payload")
  reason           String          @db.VarChar(1000)
  errorCode        String          @map("error_code") @db.VarChar(80)
  errorMessage     String          @map("error_message") @db.VarChar(2000)
  attemptedById    String          @map("attempted_by_id") @db.Uuid
  attemptedAt      DateTime        @default(now()) @map("attempted_at") @db.Timestamptz(6)
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  proposal         CommandProposal @relation(fields: [proposalId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  attemptedBy      User            @relation(fields: [attemptedById], references: [id], onDelete: Restrict)

  @@index([companyId, proposalId, attemptedAt], map: "command_proposal_attempts_company_proposal_attempted_idx")
  @@map("command_proposal_attempts")
}

model CommandProposalEvent {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  proposalId        String          @map("proposal_id") @db.Uuid
  sequence          Int
  type              String          @db.VarChar(80)
  payload           Json
  payloadHash       String          @map("payload_hash") @db.Char(64)
  previousEventHash String?         @map("previous_event_hash") @db.Char(64)
  eventHash         String          @map("event_hash") @db.Char(64)
  actorUserId       String          @map("actor_user_id") @db.Uuid
  occurredAt        DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  proposal          CommandProposal @relation(fields: [proposalId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  actor             User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([proposalId, sequence])
  @@index([companyId, proposalId, sequence], map: "command_proposal_events_company_proposal_sequence_idx")
  @@map("command_proposal_events")
}

model CommandLearningCandidate {
  id             String                         @id @default(uuid()) @db.Uuid
  organizationId String                         @map("organization_id") @db.Uuid
  companyId      String                         @map("company_id") @db.Uuid
  proposalId     String                         @map("proposal_id") @db.Uuid
  revisionId     String                         @map("revision_id") @db.Uuid
  commandName    String                         @map("command_name") @db.VarChar(100)
  commandVersion Int                            @map("command_version")
  fieldPath      String                         @map("field_path") @db.VarChar(240)
  originalValue  Json                           @map("original_value")
  correctedValue Json                           @map("corrected_value")
  status         CommandLearningCandidateStatus @default(PENDING_REVIEW)
  reviewReason   String?                        @map("review_reason") @db.VarChar(1000)
  reviewedById   String?                        @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?                      @map("reviewed_at") @db.Timestamptz(6)
  createdById    String                         @map("created_by_id") @db.Uuid
  createdAt      DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company                        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  proposal       CommandProposal                @relation(fields: [proposalId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  revision       CommandProposalRevision        @relation(fields: [revisionId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  reviewedBy     User?                          @relation("reviewed_learning_candidates", fields: [reviewedById], references: [id], onDelete: Restrict)
  createdBy      User                           @relation("created_learning_candidates", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([revisionId, fieldPath], map: "command_learning_candidates_revision_field_idx")
  @@index([companyId, status, createdAt], map: "command_learning_candidates_company_status_created_idx")
  @@index([companyId, commandName, commandVersion, fieldPath], map: "command_learning_candidates_company_field_idx")
  @@map("command_learning_candidates")
}

model CommandReview {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  companyId       String                @map("company_id") @db.Uuid
  proposalId      String                @unique @map("proposal_id") @db.Uuid
  decision        CommandReviewDecision
  acceptedPayload Json?                 @map("accepted_payload")
  reason          String                @db.VarChar(1000)
  reviewedById    String                @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime              @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  proposal        CommandProposal       @relation(fields: [proposalId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  reviewedBy      User                  @relation(fields: [reviewedById], references: [id], onDelete: Restrict)

  @@unique([proposalId, organizationId, companyId])
  @@map("command_reviews")
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String?      @map("company_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  action         String       @db.VarChar(160)
  entityType     String       @map("entity_type") @db.VarChar(100)
  entityId       String?      @map("entity_id") @db.Uuid
  metadata       Json         @default("{}")
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor          User?        @relation("actor_audit_events", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, companyId, occurredAt])
  @@map("audit_events")
}
