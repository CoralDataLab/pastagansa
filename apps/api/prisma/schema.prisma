generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum SessionStatus {
  ACTIVE
  REVOKED
}

enum ContactStatus {
  ACTIVE
  ARCHIVED
}

enum CatalogItemType {
  PRODUCT
  SERVICE
}

enum CatalogItemStatus {
  ACTIVE
  ARCHIVED
}

enum PaymentMethod {
  BANK_TRANSFER
  DIRECT_DEBIT
  CASH
  CARD
  OTHER
}

enum AddressType {
  BILLING
  SHIPPING
  OTHER
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  CONVERTED
}

enum DocumentType {
  INVOICE
  CREDIT_NOTE
  PURCHASE_INVOICE
  QUOTE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  SETTLED
  OVERDUE
  RECTIFIED
  CANCELLED
}

enum RectificationKind {
  TOTAL
  PARTIAL
  DIFFERENCE
}

enum RectificationImpact {
  DECREASE
  INCREASE
}

enum SifInvoiceType {
  F1
  R1
  R2
  R3
  R4
  R5
}

enum InvoiceEmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum DeliveryDocumentType {
  INVOICE
  QUOTE
}

enum DeliveryPurpose {
  DOCUMENT_DELIVERY
  PAYMENT_REMINDER
}

enum CommercialDocumentEventType {
  SENT
  DELIVERY_FAILED
  ACCEPTED
  REJECTED
  DISPUTED
  PARTIALLY_PAID
  PAID
  PAYMENT_PROMISED
  NOTE
}

enum CommercialEventSource {
  USER
  EMAIL
  BANK
  SYSTEM
  EINVOICE
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

enum TaxLedgerStatus {
  POSTED
}

enum TaxLedgerDirection {
  SALES
  PURCHASES
}

enum TaxBookType {
  ISSUED_INVOICES
  RECEIVED_INVOICES
}

enum SifRecordType {
  REGISTRATION
  CANCELLATION
  SUBSANATION
}

enum SifAeatSubmissionStatus {
  PENDING
  SENDING
  RETRY
  ACCEPTED
  ACCEPTED_WITH_ERRORS
  REJECTED
  FAILED
  UNKNOWN
}

enum SifMode {
  DISABLED
  NO_VERIFACTU
  VERIFACTU
}

enum AeatEnvironment {
  TEST
  PRODUCTION
}

enum PurchaseInvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  CANCELLED
}

enum PurchaseOcrStatus {
  PENDING
  PROCESSING
  REVIEW_REQUIRED
  REVIEWED
  FAILED
}

enum AccountClass {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountingRole {
  CUSTOMER_RECEIVABLE
  SUPPLIER_PAYABLE
  SALES_REVENUE
  PURCHASE_EXPENSE
  OUTPUT_VAT
  INPUT_VAT
  BANK
  WITHHOLDING_PAYABLE
}

enum FiscalYearStatus {
  OPEN
  CLOSED
}

enum AccountingPeriodStatus {
  OPEN
  LOCKED
}

enum JournalEntryStatus {
  DRAFT
  POSTED
}

enum JournalSourceType {
  MANUAL
  SALES_INVOICE
  INVOICE_CANCELLATION
  PURCHASE_INVOICE
  PAYMENT
  SUPPLIER_PAYMENT
}

enum BankTransactionStatus {
  UNMATCHED
  RECONCILED
}

model Organization {
  id                         String                       @id @default(uuid()) @db.Uuid
  name                       String
  createdAt                  DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  companies                  Company[]
  memberships                Membership[]
  auditEvents                AuditEvent[]
  contacts                   Contact[]
  quotes                     Quote[]
  contactAddresses           ContactAddress[]
  catalogItems               CatalogItem[]
  documentSequences          DocumentSequence[]
  invoices                   Invoice[]
  documentDeliveries         DocumentDelivery[]
  commercialEvents           CommercialDocumentEvent[]
  invoiceInstallments        InvoiceInstallment[]
  payments                   Payment[]
  paymentAllocations         PaymentAllocation[]
  invoiceTaxLines            InvoiceTaxLine[]
  taxLedgerEntries           TaxLedgerEntry[]
  taxLedgerAmounts           TaxLedgerAmount[]
  sifRecords                 SifRecord[]
  sifEvents                  SifEventRecord[]
  sifIntegrityAlarms         SifIntegrityAlarm[]
  sifAeatSubmissions         SifAeatSubmission[]
  purchaseInvoices           PurchaseInvoice[]
  purchaseInvoiceLines       PurchaseInvoiceLine[]
  purchaseTaxLines           PurchaseTaxLine[]
  purchaseInstallments       PurchaseInvoiceInstallment[]
  purchaseAttachments        PurchaseInvoiceAttachment[]
  purchaseApprovalTiers      PurchaseApprovalTier[]
  purchaseApprovals          PurchaseInvoiceApproval[]
  purchaseOcrJobs            PurchaseInvoiceOcrJob[]
  supplierAllocations        SupplierPaymentAllocation[]
  accounts                   Account[]
  fiscalYears                FiscalYear[]
  accountingPeriods          AccountingPeriod[]
  journalEntries             JournalEntry[]
  journalLines               JournalLine[]
  accountingRules            AccountingRule[]
  supplierPayments           SupplierPayment[]
  bankAccounts               BankAccount[]
  bankTransactions           BankTransaction[]
  bankReconciliations        BankReconciliation[]
  companyDocumentProfiles    CompanyDocumentProfile[]
  companyDocumentLogos       CompanyDocumentLogo[]
  commandExecutions          CommandExecution[]
  commandProposals           CommandProposal[]
  commandProposalRevisions   CommandProposalRevision[]
  commandProposalAssignments CommandProposalAssignment[]
  commandProposalAttempts    CommandProposalAttempt[]
  commandProposalEvents      CommandProposalEvent[]
  commandLearningCandidates  CommandLearningCandidate[]
  commandReviews             CommandReview[]

  @@map("organizations")
}

model Company {
  id                         String                       @id @default(uuid()) @db.Uuid
  organizationId             String                       @map("organization_id") @db.Uuid
  legalName                  String                       @map("legal_name")
  soleShareholder            Boolean                      @default(false) @map("sole_shareholder")
  taxId                      String                       @map("tax_id") @db.VarChar(40)
  country                    String                       @default("ES") @db.Char(2)
  baseCurrency               String                       @default("EUR") @map("base_currency") @db.Char(3)
  timezone                   String                       @default("Europe/Madrid") @db.VarChar(64)
  sifMode                    SifMode                      @default(DISABLED) @map("sif_mode")
  aeatEnvironment            AeatEnvironment              @default(PRODUCTION) @map("aeat_environment")
  sifSoftwareProducerName    String?                      @map("sif_software_producer_name") @db.VarChar(240)
  sifSoftwareProducerTaxId   String?                      @map("sif_software_producer_tax_id") @db.VarChar(40)
  sifSoftwareName            String?                      @map("sif_software_name") @db.VarChar(120)
  sifSoftwareId              String?                      @map("sif_software_id") @db.VarChar(120)
  sifSoftwareVersion         String?                      @map("sif_software_version") @db.VarChar(60)
  sifInstallationNumber      String?                      @map("sif_installation_number") @db.VarChar(120)
  createdAt                  DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization               Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships                Membership[]
  auditEvents                AuditEvent[]
  contacts                   Contact[]
  quotes                     Quote[]
  contactAddresses           ContactAddress[]
  catalogItems               CatalogItem[]
  documentSequences          DocumentSequence[]
  invoices                   Invoice[]
  documentDeliveries         DocumentDelivery[]
  commercialEvents           CommercialDocumentEvent[]
  invoiceInstallments        InvoiceInstallment[]
  payments                   Payment[]
  paymentAllocations         PaymentAllocation[]
  invoiceTaxLines            InvoiceTaxLine[]
  taxLedgerEntries           TaxLedgerEntry[]
  taxLedgerAmounts           TaxLedgerAmount[]
  sifRecords                 SifRecord[]
  sifEvents                  SifEventRecord[]
  sifIntegrityAlarms         SifIntegrityAlarm[]
  sifAeatSubmissions         SifAeatSubmission[]
  purchaseInvoices           PurchaseInvoice[]
  purchaseInvoiceLines       PurchaseInvoiceLine[]
  purchaseTaxLines           PurchaseTaxLine[]
  purchaseInstallments       PurchaseInvoiceInstallment[]
  purchaseAttachments        PurchaseInvoiceAttachment[]
  purchaseApprovalTiers      PurchaseApprovalTier[]
  purchaseApprovals          PurchaseInvoiceApproval[]
  purchaseOcrJobs            PurchaseInvoiceOcrJob[]
  supplierAllocations        SupplierPaymentAllocation[]
  accounts                   Account[]
  fiscalYears                FiscalYear[]
  accountingPeriods          AccountingPeriod[]
  journalEntries             JournalEntry[]
  journalLines               JournalLine[]
  accountingRules            AccountingRule[]
  supplierPayments           SupplierPayment[]
  bankAccounts               BankAccount[]
  bankTransactions           BankTransaction[]
  bankReconciliations        BankReconciliation[]
  documentProfile            CompanyDocumentProfile?
  documentLogo               CompanyDocumentLogo?
  commandExecutions          CommandExecution[]
  commandProposals           CommandProposal[]
  commandProposalRevisions   CommandProposalRevision[]
  commandProposalAssignments CommandProposalAssignment[]
  commandProposalAttempts    CommandProposalAttempt[]
  commandProposalEvents      CommandProposalEvent[]
  commandLearningCandidates  CommandLearningCandidate[]
  commandReviews             CommandReview[]

  @@unique([organizationId, taxId])
  @@index([organizationId])
  @@map("companies")
}

model CompanyDocumentProfile {
  id                          String       @id @default(uuid()) @db.Uuid
  organizationId              String       @map("organization_id") @db.Uuid
  companyId                   String       @unique @map("company_id") @db.Uuid
  tradeName                   String?      @map("trade_name") @db.VarChar(240)
  addressLine1                String?      @map("address_line_1") @db.VarChar(240)
  addressLine2                String?      @map("address_line_2") @db.VarChar(240)
  postalCode                  String?      @map("postal_code") @db.VarChar(20)
  city                        String?      @db.VarChar(120)
  province                    String?      @db.VarChar(120)
  addressCountry              String?      @map("address_country") @db.Char(2)
  email                       String?      @db.VarChar(320)
  phone                       String?      @db.VarChar(40)
  website                     String?      @db.VarChar(500)
  bankIban                    String?      @map("bank_iban") @db.VarChar(34)
  paymentInstructions         String?      @map("payment_instructions") @db.VarChar(2000)
  paymentTerms                String?      @map("payment_terms") @db.VarChar(1000)
  defaultNotes                String?      @map("default_notes") @db.VarChar(5000)
  documentFooter              String?      @map("document_footer") @db.VarChar(1000)
  primaryColor                String?      @map("primary_color") @db.Char(7)
  invoiceEmailSubjectTemplate String?      @map("invoice_email_subject_template") @db.VarChar(300)
  quoteEmailSubjectTemplate   String?      @map("quote_email_subject_template") @db.VarChar(300)
  emailBodyTemplate           String?      @map("email_body_template") @db.VarChar(2000)
  createdAt                   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization                Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company                     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("company_document_profiles")
}

model CompanyDocumentLogo {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  companyId      String       @unique @map("company_id") @db.Uuid
  mediaType      String       @map("media_type") @db.VarChar(100)
  sizeBytes      Int          @map("size_bytes")
  width          Int
  height         Int
  sha256         String       @db.Char(64)
  content        Bytes
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("company_document_logos")
}

model CatalogItem {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  companyId            String                @map("company_id") @db.Uuid
  type                 CatalogItemType
  sku                  String?               @db.VarChar(80)
  name                 String                @db.VarChar(240)
  description          String?
  unit                 String                @default("unit") @db.VarChar(30)
  salesPrice           Decimal?              @map("sales_price") @db.Decimal(14, 2)
  currency             String                @default("EUR") @db.Char(3)
  suggestedTaxCode     String?               @map("suggested_tax_code") @db.VarChar(80)
  revenueAccountCode   String?               @map("revenue_account_code") @db.VarChar(20)
  expenseAccountCode   String?               @map("expense_account_code") @db.VarChar(20)
  trackInventory       Boolean               @default(false) @map("track_inventory")
  status               CatalogItemStatus     @default(ACTIVE)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  quoteLines           QuoteLine[]
  invoiceLines         InvoiceLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]

  @@unique([companyId, sku])
  @@index([companyId, status, name])
  @@map("catalog_items")
}

model Contact {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  legalName        String            @map("legal_name") @db.VarChar(240)
  tradeName        String?           @map("trade_name") @db.VarChar(240)
  taxId            String?           @map("tax_id") @db.VarChar(40)
  taxCountry       String            @default("ES") @map("tax_country") @db.Char(2)
  email            String?           @db.VarChar(320)
  phone            String?           @db.VarChar(40)
  paymentTermsDays Int?              @map("payment_terms_days")
  paymentMethod    PaymentMethod?    @map("payment_method")
  isCustomer       Boolean           @default(false) @map("is_customer")
  isSupplier       Boolean           @default(false) @map("is_supplier")
  status           ContactStatus     @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  addresses        ContactAddress[]
  quotes           Quote[]
  invoices         Invoice[]
  taxLedgerEntries TaxLedgerEntry[]
  purchaseInvoices PurchaseInvoice[]
  journalLines     JournalLine[]

  @@unique([companyId, taxId])
  @@unique([id, organizationId, companyId])
  @@index([companyId, status, legalName])
  @@map("contacts")
}

model DocumentSequence {
  id                      String            @id @default(uuid()) @db.Uuid
  organizationId          String            @map("organization_id") @db.Uuid
  companyId               String            @map("company_id") @db.Uuid
  documentType            DocumentType      @map("document_type")
  series                  String            @db.VarChar(30)
  nextNumber              BigInt            @default(1) @map("next_number")
  padding                 Int               @default(4)
  active                  Boolean           @default(true)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization            Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company                 Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoices                Invoice[]
  purchaseInvoices        PurchaseInvoice[] @relation("PurchaseReceptionSequence")
  pendingPurchaseInvoices PurchaseInvoice[] @relation("PurchaseRequestedSequence")
  quotes                  Quote[]

  @@unique([companyId, documentType, series])
  @@unique([id, organizationId, companyId])
  @@index([companyId, documentType, active])
  @@map("document_sequences")
}

model Invoice {
  id                    String                    @id @default(uuid()) @db.Uuid
  organizationId        String                    @map("organization_id") @db.Uuid
  companyId             String                    @map("company_id") @db.Uuid
  contactId             String                    @map("contact_id") @db.Uuid
  sequenceId            String?                   @map("sequence_id") @db.Uuid
  originalInvoiceId     String?                   @map("original_invoice_id") @db.Uuid
  documentType          DocumentType              @default(INVOICE) @map("document_type")
  sifInvoiceType        SifInvoiceType            @default(F1) @map("sif_invoice_type")
  rectificationKind     RectificationKind?        @map("rectification_kind")
  rectificationImpact   RectificationImpact?      @map("rectification_impact")
  rectificationReason   String?                   @map("rectification_reason") @db.VarChar(1000)
  vatRecoveryReview     Json?                     @map("vat_recovery_review")
  draftCode             String                    @default(cuid()) @map("draft_code") @db.VarChar(40)
  series                String?                   @db.VarChar(30)
  number                BigInt?
  fullNumber            String?                   @map("full_number") @db.VarChar(80)
  issuanceKey           String?                   @map("issuance_key") @db.VarChar(128)
  status                InvoiceStatus             @default(DRAFT)
  issuerLegalName       String                    @map("issuer_legal_name") @db.VarChar(240)
  issuerTaxId           String                    @map("issuer_tax_id") @db.VarChar(40)
  issuerSnapshot        Json                      @default("{}") @map("issuer_snapshot")
  issuerSnapshotVersion Int                       @default(1) @map("issuer_snapshot_version")
  issuerLogoMediaType   String?                   @map("issuer_logo_media_type") @db.VarChar(100)
  issuerLogoSha256      String?                   @map("issuer_logo_sha256") @db.Char(64)
  issuerLogoContent     Bytes?                    @map("issuer_logo_content")
  sifMode               SifMode                   @default(DISABLED) @map("sif_mode")
  aeatEnvironment       AeatEnvironment           @default(PRODUCTION) @map("aeat_environment")
  customerLegalName     String                    @map("customer_legal_name") @db.VarChar(240)
  customerTaxId         String?                   @map("customer_tax_id") @db.VarChar(40)
  customerEmail         String?                   @map("customer_email") @db.VarChar(320)
  billingAddress        Json?                     @map("billing_address")
  issueDate             DateTime                  @map("issue_date") @db.Date
  operationDate         DateTime?                 @map("operation_date") @db.Date
  dueDate               DateTime?                 @map("due_date") @db.Date
  currency              String                    @default("EUR") @db.Char(3)
  notes                 String?
  subtotal              Decimal                   @db.Decimal(14, 2)
  discountTotal         Decimal                   @map("discount_total") @db.Decimal(14, 2)
  taxTotal              Decimal                   @map("tax_total") @db.Decimal(14, 2)
  total                 Decimal                   @db.Decimal(14, 2)
  amountPaid            Decimal                   @default(0) @map("amount_paid") @db.Decimal(14, 2)
  creditedAmount        Decimal                   @default(0) @map("credited_amount") @db.Decimal(14, 2)
  amountDue             Decimal                   @default(0) @map("amount_due") @db.Decimal(14, 2)
  issuedAt              DateTime?                 @map("issued_at") @db.Timestamptz(6)
  cancelledAt           DateTime?                 @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason    String?                   @map("cancellation_reason") @db.VarChar(1000)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company               Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contact               Contact                   @relation(fields: [contactId], references: [id], onDelete: Restrict)
  sequence              DocumentSequence?         @relation(fields: [sequenceId], references: [id], onDelete: Restrict)
  originalInvoice       Invoice?                  @relation("InvoiceRectifications", fields: [originalInvoiceId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  rectifications        Invoice[]                 @relation("InvoiceRectifications")
  lines                 InvoiceLine[]
  emailDeliveries       DocumentDelivery[]
  commercialEvents      CommercialDocumentEvent[]
  installments          InvoiceInstallment[]
  paymentAllocations    PaymentAllocation[]
  taxLines              InvoiceTaxLine[]
  taxLedgerEntry        TaxLedgerEntry?
  sifRecords            SifRecord[]
  sourceQuote           Quote?

  @@unique([companyId, draftCode])
  @@unique([companyId, series, number])
  @@unique([companyId, issuanceKey])
  @@unique([id, organizationId, companyId])
  @@index([companyId, status, issueDate])
  @@index([originalInvoiceId, createdAt])
  @@map("invoices")
}

model SifRecord {
  id                   String              @id @default(uuid()) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  companyId            String              @map("company_id") @db.Uuid
  invoiceId            String              @map("invoice_id") @db.Uuid
  recordType           SifRecordType       @map("record_type")
  chainPosition        BigInt              @map("chain_position")
  issuerTaxId          String              @map("issuer_tax_id") @db.VarChar(40)
  invoiceNumber        String              @map("invoice_number") @db.VarChar(80)
  invoiceIssueDate     DateTime            @map("invoice_issue_date") @db.Date
  invoiceType          String              @map("invoice_type") @db.VarChar(2)
  taxTotal             Decimal             @map("tax_total") @db.Decimal(14, 2)
  total                Decimal             @db.Decimal(14, 2)
  generatedAt          DateTime            @map("generated_at") @db.Timestamptz(6)
  previousRecordId     String?             @map("previous_record_id") @db.Uuid
  previousRecordHash   String?             @map("previous_record_hash") @db.Char(64)
  recordHash           String              @map("record_hash") @db.Char(64)
  hashAlgorithm        String              @default("SHA-256") @map("hash_algorithm") @db.VarChar(20)
  specificationVersion String              @default("AEAT-HASH-0.1.2") @map("specification_version") @db.VarChar(40)
  payload              Json
  softwareSnapshot     Json                @default("{}") @map("software_snapshot")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company              Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoice              Invoice             @relation(fields: [invoiceId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  previousRecord       SifRecord?          @relation("SifRecordChain", fields: [previousRecordId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  nextRecords          SifRecord[]         @relation("SifRecordChain")
  aeatSubmissions      SifAeatSubmission[]

  @@unique([companyId, chainPosition])
  @@unique([previousRecordId])
  @@unique([id, organizationId, companyId])
  @@index([companyId, invoiceId, recordType])
  @@index([companyId, generatedAt, id])
  @@map("sif_records")
}

model SifEventRecord {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  eventType         String           @map("event_type") @db.Char(2)
  chainPosition     BigInt           @map("chain_position")
  generatedAt       DateTime         @map("generated_at") @db.Timestamptz(6)
  previousEventId   String?          @map("previous_event_id") @db.Uuid
  previousEventHash String?          @map("previous_event_hash") @db.Char(64)
  eventHash         String           @map("event_hash") @db.Char(64)
  hashInput         Json             @map("hash_input")
  signedXml         String           @map("signed_xml") @db.Text
  signedXmlSha256   String           @map("signed_xml_sha256") @db.Char(64)
  softwareSnapshot  Json             @map("software_snapshot")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  previousEvent     SifEventRecord?  @relation("SifEventChain", fields: [previousEventId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  nextEvents        SifEventRecord[] @relation("SifEventChain")

  @@unique([companyId, chainPosition])
  @@unique([previousEventId])
  @@unique([id, organizationId, companyId])
  @@index([companyId, generatedAt, id])
  @@map("sif_event_records")
}

model SifIntegrityAlarm {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  companyId       String       @map("company_id") @db.Uuid
  fingerprint     String       @db.Char(64)
  source          String       @db.VarChar(20)
  chainPosition   BigInt?      @map("chain_position")
  reason          String       @db.VarChar(300)
  firstDetectedAt DateTime     @default(now()) @map("first_detected_at") @db.Timestamptz(6)
  lastDetectedAt  DateTime     @default(now()) @map("last_detected_at") @db.Timestamptz(6)
  resolvedAt      DateTime?    @map("resolved_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, fingerprint])
  @@index([companyId, resolvedAt, lastDetectedAt])
  @@map("sif_integrity_alarms")
}

model SifAeatSubmission {
  id                  String                  @id @default(uuid()) @db.Uuid
  organizationId      String                  @map("organization_id") @db.Uuid
  companyId           String                  @map("company_id") @db.Uuid
  recordId            String                  @map("record_id") @db.Uuid
  status              SifAeatSubmissionStatus @default(PENDING)
  attempts            Int                     @default(0)
  availableAt         DateTime                @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt            DateTime?               @map("locked_at") @db.Timestamptz(6)
  lastAttemptAt       DateTime?               @map("last_attempt_at") @db.Timestamptz(6)
  completedAt         DateTime?               @map("completed_at") @db.Timestamptz(6)
  requestSha256       String                  @map("request_sha256") @db.Char(64)
  incident            Boolean                 @default(false)
  lastAttemptedXml    String?                 @map("last_attempted_xml") @db.Text
  lastAttemptedSha256 String?                 @map("last_attempted_sha256") @db.Char(64)
  httpStatus          Int?                    @map("http_status")
  globalStatus        String?                 @map("global_status") @db.VarChar(30)
  recordStatus        String?                 @map("record_status") @db.VarChar(30)
  csv                 String?                 @db.VarChar(120)
  errorCode           String?                 @map("error_code") @db.VarChar(20)
  errorDescription    String?                 @map("error_description") @db.Text
  waitSeconds         Int?                    @map("wait_seconds")
  responseXml         String?                 @map("response_xml") @db.Text
  reconciliationXml   String?                 @map("reconciliation_xml") @db.Text
  lastError           String?                 @map("last_error") @db.Text
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company             Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  record              SifRecord               @relation(fields: [recordId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)

  @@unique([companyId, recordId])
  @@index([status, availableAt, createdAt])
  @@index([companyId, createdAt])
  @@map("sif_aeat_submissions")
}

model TaxRule {
  id                String            @id @default(uuid()) @db.Uuid
  jurisdiction      String            @db.VarChar(20)
  code              String            @db.VarChar(80)
  taxFamily         String            @map("tax_family") @db.VarChar(30)
  operationType     String            @map("operation_type") @db.VarChar(50)
  rate              Decimal?          @db.Decimal(9, 6)
  surchargeRate     Decimal?          @map("surcharge_rate") @db.Decimal(9, 6)
  subject           Boolean
  exempt            Boolean           @default(false)
  reverseCharge     Boolean           @default(false) @map("reverse_charge")
  deductionRight    Boolean           @default(true) @map("deduction_right")
  intraEu           Boolean           @default(false) @map("intra_eu")
  importOperation   Boolean           @default(false) @map("import_operation")
  exportOperation   Boolean           @default(false) @map("export_operation")
  specialRegimeCode String?           @map("special_regime_code") @db.VarChar(50)
  legalReference    String            @map("legal_reference")
  effectiveFrom     DateTime          @map("effective_from") @db.Date
  effectiveTo       DateTime?         @map("effective_to") @db.Date
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  invoiceTaxLines   InvoiceTaxLine[]
  purchaseTaxLines  PurchaseTaxLine[]
  ledgerAmounts     TaxLedgerAmount[]

  @@unique([code, effectiveFrom])
  @@index([jurisdiction, effectiveFrom, effectiveTo])
  @@map("tax_rules")
}

model InvoiceTaxLine {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  invoiceId       String            @map("invoice_id") @db.Uuid
  invoiceLineId   String            @unique @map("invoice_line_id") @db.Uuid
  taxRuleId       String            @map("tax_rule_id") @db.Uuid
  taxCode         String            @map("tax_code") @db.VarChar(80)
  taxableBase     Decimal           @map("taxable_base") @db.Decimal(14, 2)
  taxRate         Decimal?          @map("tax_rate") @db.Decimal(9, 6)
  taxAmount       Decimal           @map("tax_amount") @db.Decimal(14, 2)
  surchargeRate   Decimal?          @map("surcharge_rate") @db.Decimal(9, 6)
  surchargeAmount Decimal           @default(0) @map("surcharge_amount") @db.Decimal(14, 2)
  subject         Boolean
  exempt          Boolean
  exemptionReason String?           @map("exemption_reason") @db.VarChar(100)
  reverseCharge   Boolean           @map("reverse_charge")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoice         Invoice           @relation(fields: [invoiceId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Cascade)
  invoiceLine     InvoiceLine       @relation(fields: [invoiceLineId, invoiceId, organizationId, companyId], references: [id, invoiceId, organizationId, companyId], onDelete: Cascade)
  taxRule         TaxRule           @relation(fields: [taxRuleId], references: [id], onDelete: Restrict)
  ledgerAmounts   TaxLedgerAmount[]

  @@unique([id, organizationId, companyId])
  @@index([invoiceId])
  @@map("invoice_tax_lines")
}

model TaxLedgerEntry {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  companyId           String               @map("company_id") @db.Uuid
  invoiceId           String?              @unique @map("invoice_id") @db.Uuid
  purchaseInvoiceId   String?              @unique @map("purchase_invoice_id") @db.Uuid
  cancellationOfId    String?              @unique @map("cancellation_of_id") @db.Uuid
  direction           TaxLedgerDirection
  bookType            TaxBookType          @map("book_type")
  issueDate           DateTime             @map("issue_date") @db.Date
  operationDate       DateTime             @map("operation_date") @db.Date
  taxPointDate        DateTime             @map("tax_point_date") @db.Date
  receivedDate        DateTime?            @map("received_date") @db.Date
  counterpartyId      String               @map("counterparty_id") @db.Uuid
  counterpartyTaxId   String?              @map("counterparty_tax_id") @db.VarChar(40)
  counterpartyCountry String               @default("ES") @map("counterparty_country") @db.Char(2)
  documentNumber      String               @map("document_number") @db.VarChar(100)
  registrationNumber  String?              @map("registration_number") @db.VarChar(80)
  correctionOfId      String?              @map("correction_of_id") @db.Uuid
  rectificationImpact RectificationImpact? @map("rectification_impact")
  status              TaxLedgerStatus      @default(POSTED)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoice             Invoice?             @relation(fields: [invoiceId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  purchaseInvoice     PurchaseInvoice?     @relation(fields: [purchaseInvoiceId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  counterparty        Contact              @relation(fields: [counterpartyId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  correctionOf        TaxLedgerEntry?      @relation("TaxLedgerCorrections", fields: [correctionOfId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  corrections         TaxLedgerEntry[]     @relation("TaxLedgerCorrections")
  cancellationOf      TaxLedgerEntry?      @relation("TaxLedgerCancellations", fields: [cancellationOfId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  cancelledBy         TaxLedgerEntry?      @relation("TaxLedgerCancellations")
  amounts             TaxLedgerAmount[]

  @@unique([id, organizationId, companyId])
  @@unique([invoiceId, organizationId, companyId])
  @@unique([purchaseInvoiceId, organizationId, companyId])
  @@unique([cancellationOfId, organizationId, companyId])
  @@index([companyId, taxPointDate, id])
  @@map("tax_ledger_entries")
}

model TaxLedgerAmount {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  taxLedgerEntryId  String           @map("tax_ledger_entry_id") @db.Uuid
  invoiceTaxLineId  String?          @map("invoice_tax_line_id") @db.Uuid
  purchaseTaxLineId String?          @map("purchase_tax_line_id") @db.Uuid
  taxRuleId         String           @map("tax_rule_id") @db.Uuid
  taxableBase       Decimal          @map("taxable_base") @db.Decimal(14, 2)
  rate              Decimal?         @db.Decimal(9, 6)
  taxAmount         Decimal          @map("tax_amount") @db.Decimal(14, 2)
  surchargeRate     Decimal?         @map("surcharge_rate") @db.Decimal(9, 6)
  surchargeAmount   Decimal          @default(0) @map("surcharge_amount") @db.Decimal(14, 2)
  deductibleAmount  Decimal?         @map("deductible_amount") @db.Decimal(14, 2)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  entry             TaxLedgerEntry   @relation(fields: [taxLedgerEntryId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  invoiceTaxLine    InvoiceTaxLine?  @relation(fields: [invoiceTaxLineId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  purchaseTaxLine   PurchaseTaxLine? @relation(fields: [purchaseTaxLineId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  taxRule           TaxRule          @relation(fields: [taxRuleId], references: [id], onDelete: Restrict)

  @@unique([taxLedgerEntryId, invoiceTaxLineId])
  @@unique([taxLedgerEntryId, purchaseTaxLineId])
  @@index([companyId, taxRuleId])
  @@map("tax_ledger_amounts")
}

model PurchaseInvoice {
  id                    String                       @id @default(uuid()) @db.Uuid
  organizationId        String                       @map("organization_id") @db.Uuid
  companyId             String                       @map("company_id") @db.Uuid
  supplierId            String                       @map("supplier_id") @db.Uuid
  sequenceId            String?                      @map("sequence_id") @db.Uuid
  requestedSequenceId   String?                      @map("requested_sequence_id") @db.Uuid
  draftCode             String                       @default(cuid()) @map("draft_code") @db.VarChar(40)
  supplierInvoiceNumber String                       @map("supplier_invoice_number") @db.VarChar(100)
  receptionSeries       String?                      @map("reception_series") @db.VarChar(30)
  receptionNumber       BigInt?                      @map("reception_number")
  receptionFullNumber   String?                      @map("reception_full_number") @db.VarChar(80)
  approvalKey           String?                      @map("approval_key") @db.VarChar(128)
  requiredApprovals     Int                          @default(1) @map("required_approvals")
  approvalCount         Int                          @default(0) @map("approval_count")
  status                PurchaseInvoiceStatus        @default(DRAFT)
  supplierLegalName     String                       @map("supplier_legal_name") @db.VarChar(240)
  supplierTaxId         String?                      @map("supplier_tax_id") @db.VarChar(40)
  supplierTaxCountry    String                       @default("ES") @map("supplier_tax_country") @db.Char(2)
  issueDate             DateTime                     @map("issue_date") @db.Date
  operationDate         DateTime                     @map("operation_date") @db.Date
  receivedDate          DateTime                     @map("received_date") @db.Date
  deductionDate         DateTime                     @map("deduction_date") @db.Date
  dueDate               DateTime?                    @map("due_date") @db.Date
  currency              String                       @default("EUR") @db.Char(3)
  notes                 String?
  subtotal              Decimal                      @db.Decimal(14, 2)
  discountTotal         Decimal                      @map("discount_total") @db.Decimal(14, 2)
  taxTotal              Decimal                      @map("tax_total") @db.Decimal(14, 2)
  deductibleTaxTotal    Decimal                      @map("deductible_tax_total") @db.Decimal(14, 2)
  total                 Decimal                      @db.Decimal(14, 2)
  withholdingRate       Decimal                      @default(0) @map("withholding_rate") @db.Decimal(5, 2)
  withholdingAmount     Decimal                      @default(0) @map("withholding_amount") @db.Decimal(14, 2)
  amountPaid            Decimal                      @default(0) @map("amount_paid") @db.Decimal(14, 2)
  amountDue             Decimal                      @default(0) @map("amount_due") @db.Decimal(14, 2)
  approvedAt            DateTime?                    @map("approved_at") @db.Timestamptz(6)
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization          Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company               Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier              Contact                      @relation(fields: [supplierId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  sequence              DocumentSequence?            @relation("PurchaseReceptionSequence", fields: [sequenceId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  requestedSequence     DocumentSequence?            @relation("PurchaseRequestedSequence", fields: [requestedSequenceId, organizationId, companyId], references: [id, organizationId, companyId], onDelete: Restrict)
  lines                 PurchaseInvoiceLine[]
  taxLines              PurchaseTaxLine[]
  taxLedgerEntry        TaxLedgerEntry?
  supplierPayments      SupplierPayment[]
  installments          PurchaseInvoiceInstallment[]
  attachments           PurchaseInvoiceAttachment[]
  approvals             PurchaseInvoiceApproval[]
  ocrJobs               PurchaseInvoiceOcrJob[]

  @@unique([companyId, draftCode])
  @@unique([companyId, supplierId, supplierInvoiceNumber])
  @@unique([companyId, receptionSeries, receptionNumber])
  @@unique([companyId, approvalKey])
  @@unique([id, organizationId, companyId])
  @@index([companyId, status, receivedDate])
  @@map("purchase_invoices")
}

model PurchaseApprovalTier {
