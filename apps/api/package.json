{
  "name": "@pastagansa/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:e2e": "PORT=3100 OCR_WORKER_ENABLED=true THROTTLE_LIMIT=1000 node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --runInBand",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "DATABASE_URL=$DIRECT_DATABASE_URL prisma migrate dev",
    "db:deploy": "DATABASE_URL=$DIRECT_DATABASE_URL prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "6.12.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@types/qrcode": "^1.5.5",
    "@xmldom/xmldom": "^0.9.12",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.3.0",
    "jose": "5.10.0",
    "nodemailer": "10.0.13",
    "pdfkit": "0.20.2",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "7.0.0",
    "xadesjs": "^2.6.8",
    "xmldsigjs": "^2.8.8",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.30",
    "@types/pdfkit": "0.17.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "prisma": "6.12.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
